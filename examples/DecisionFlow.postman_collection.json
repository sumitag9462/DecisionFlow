{
  "info": {
    "name": "DecisionFlow | ScoreMe Exercise",
    "description": "Local API examples. Reusing a key returns the original request; use a new key for each scenario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "requestId",
      "value": "REPLACE_WITH_ID"
    }
  ],
  "item": [
    {
      "name": "List workflow definitions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/workflows",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "workflows"
          ]
        }
      }
    },
    {
      "name": "Approve vendor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/requests",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "requests"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workflowId\": \"vendor-approval\",\n  \"idempotencyKey\": \"postman-vendor-001\",\n  \"data\": {\n    \"vendorName\": \"Northwind Supplies\",\n    \"annualSpend\": 150000,\n    \"riskScore\": 19,\n    \"blacklisted\": false,\n    \"documentsComplete\": true\n  },\n  \"simulation\": \"ok\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
