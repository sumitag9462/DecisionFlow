{
  "name": "decisionflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable decision workflow API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:core": "node --test tests/core.node.test.js",
    "test:integration": "jest --testPathPattern=integration --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "mongoose": "^8.14.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.jest.test.js", "**/tests/**/*.integration.test.js"],
    "testTimeout": 15000
  }
}
