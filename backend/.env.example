PORT=3001
HOST=127.0.0.1
# MongoDB Connection String
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/decisionflow
# MongoDB Atlas (Replace placeholders with your rotated credentials):
# MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.w9yqhpl.mongodb.net/decisionflow?retryWrites=true&w=majority

# Dedicated Test Database (Used only by npm run test:integration)
TEST_MONGO_URI=mongodb://127.0.0.1:27017/decisionflow_integration_test

# JWT Signing Secret (Minimum 32 characters in production)
JWT_SECRET=decisionflow-development-secret-key-32chars

CLIENT_ORIGIN=http://localhost:5173
